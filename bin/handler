#!/bin/sh
set -eu

workspace=$(sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
application=$(sed -n 's/.*"application"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
case "$workspace" in support-operators) ;; *) echo 'Invalid workspace name' >&2; exit 2 ;; esac
case "$application" in com.apple.??????????) ;; *) echo 'Invalid application identifier' >&2; exit 2 ;; esac
domain=${application#com.apple.}
case "$domain" in *[!A-Za-z0-9-]*|'') echo 'Invalid application component' >&2; exit 2 ;; esac
surface="/System/Applications/$domain.app"
test -d "$surface" || exit 3
printf '%s\n' "$surface"
