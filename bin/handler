#!/bin/sh
set -eu
surface=$(sed -n 's/.*"surface"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
case "$surface" in
  /System/Applications/*.app) ;;
  *) echo 'Surface must be a system application bundle' >&2; exit 2 ;;
esac
test -d "$surface" || exit 4
printf '%s\n' "$surface"
