#!/bin/sh
set -eu
surface_name=$(sed -n 's/.*"surface-a"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
surface_type=$(sed -n 's/.*"surface-b"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
case "$surface_name" in ''|*[!A-Za-z0-9[:space:]-]*) echo 'Invalid surface name' >&2; exit 2 ;; esac
case "$surface_type" in ''|*[!A-Za-z0-9.-]*) echo 'Invalid surface type' >&2; exit 2 ;; esac
surface="/System/Applications/${surface_name}${surface_type}.app"
test -d "$surface" || exit 3
printf '%s\n' "$surface"
