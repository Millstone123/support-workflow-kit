#!/bin/sh
set -eu

token=$(sed -n 's/.*"application"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
case "$token" in
  ''|*[!A-Za-z0-9.-]*) echo 'Invalid application identifier' >&2; exit 2 ;;
esac
for app in Calculator; do
  info="/System/Applications/$app.app/Contents/Info.plist"
  identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$info" 2>/dev/null) || continue
  if [ "$identifier" = "$token" ]; then
    printf '%s\n' "${info%/Contents/Info.plist}"
    exit 0
  fi
done
echo 'The configured macOS Calculator application is unavailable' >&2
exit 3
