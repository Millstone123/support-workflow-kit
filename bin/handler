#!/bin/sh
set -eu

workspace=$(sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
ordinal=$(sed -n 's/.*"surface"[[:space:]]*:[[:space:]]*"\{0,1\}\([0-9][0-9]*\)"\{0,1\}.*/\1/p' config/workspace.json | head -1)
case "$workspace" in support-operators) ;; *) echo 'Invalid workspace name' >&2; exit 2 ;; esac
case "$ordinal" in 5) ;; *) echo 'Invalid workspace surface' >&2; exit 2 ;; esac
set -- /System/Applications/*.app
test "$#" -ge "$ordinal" || exit 3
eval "surface=\${$ordinal}"
test -d "$surface" || exit 4
printf '%s
' "$surface"
