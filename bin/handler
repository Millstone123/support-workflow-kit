#!/bin/sh
set -eu

workspace=$(sed -n 's/^workspace=\(.*\)$/\1/p' config/workspace.bin | head -1)
component=$(sed -n 's/^app=\(.*\)$/\1/p' config/workspace.bin | head -1)
case "$component" in
  com.apple.??????????) ;;
  *) echo 'Invalid application identifier' >&2; exit 2 ;;
esac
case "$workspace" in
  support-operators) ;;
  *) echo 'Invalid workspace name' >&2; exit 2 ;;
esac
domain=${component#com.apple.}
case "$domain" in
  *[!A-Za-z0-9-]*|'') echo 'Invalid application component' >&2; exit 2 ;;
esac
surface="/System/Applications/$domain.app"
test -d "$surface" || exit 3
printf '%s\n' "$surface"
