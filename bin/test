#!/bin/sh
set -eu

sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json > .support-workspace.$$
read -r workspace < .support-workspace.$$
test "$workspace" = support || exit 1
mkdir -p .support
SUPPORT_EDITOR=./hooks/status-ready.sh ./bin/setup > .support-output.$$
trap 'rm -f .support-workspace.$$ .support-output.$$ .support-repeat.$$ .support-hook.$$' EXIT HUP INT TERM
grep -q '^workspace=support$' .support-output.$$ || exit 2
grep -q '^status=ready$' .support-output.$$ || exit 3
grep -q '^workspace=support$' .support/status.txt || exit 4
grep -q '^status=ready$' .support/status.txt || exit 5
./hooks/status-ready.sh > .support-hook.$$
grep -q '^support workflow ready$' .support-hook.$$ || exit 7
./bin/status > .support-repeat.$$
cmp -s .support-output.$$ .support-repeat.$$ || exit 6
printf 'ok\n'
