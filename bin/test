#!/bin/sh
set -eu
workspace=$(sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
marker=$(sed -n 's/.*"marker"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
test "$workspace" = support-operators || exit 1
test "$marker" = apple || exit 2
mkdir -p .workspace
./bin/status > .workspace-test.$$
trap 'rm -f .workspace-test.$$' EXIT HUP INT TERM
grep -q '^workspace=support-operators$' .workspace-test.$$ || exit 3
grep -q '^status=ready$' .workspace-test.$$ || exit 4
printf 'ok\n'
