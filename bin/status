#!/bin/sh
set -eu

workspace=$(sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' config/workspace.json | head -1)
case "$workspace" in
  ''|*[!A-Za-z0-9._-]*) echo 'Invalid workspace name' >&2; exit 2 ;;
esac
if [ ! -f .workspace/status.txt ]; then
  mkdir -p .workspace
  printf 'workspace=%s\nstatus=ready\n' "$workspace" > .workspace/status.txt
fi
cat .workspace/status.txt
